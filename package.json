{
  "name": "roster-lab",
  "version": "0.1.0",
  "private": true,
  "description": "Local workspace for organizing Claude Duet and OpenAI dot employees. Provider computers are not provisioned by this app.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node --import tsx scripts/dev.ts",
    "start": "vite build && ROSTER_LAB_SERVE_DIST=1 node --experimental-sqlite --import tsx src/server/index.ts",
    "web": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit && biome check src tests",
    "test": "node --experimental-sqlite --import tsx --test tests/*.test.ts",
    "setup": "bash scripts/setup.sh"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "playwright-core": "^1.49.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@tailwindcss/vite": "^4.1.11",
    "@types/node": "^22.20.5",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "tailwindcss": "^4.1.11",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vite": "^7.0.6"
  }
}
